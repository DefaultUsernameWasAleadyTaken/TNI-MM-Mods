# Шаблон workflow релиза мода
#
# НЕ кладите этот файл в .github/workflows/ как есть — GitHub его не запустит
# с расширением .example (и не должен: шаблон не релизит сам себя).
#
# Как использовать:
#   1. Скопируйте:  cp templates/release-mod.yml.example .github/workflows/release-<mod-id>.yml
#   2. Замените ВСЕ вхождения  __MOD_ID__  на ваш id (тот же, что папка mods/<mod-id>/)
#   3. Закоммитьте в beta → merge в main → CI создаст тег __MOD_ID__-vX.Y.Z
#
# Релиз только с ветки main.

name: Release __MOD_ID__

on:
  workflow_dispatch:
    inputs:
      version:
        description: "SemVer without v (e.g. 0.1.0). Empty = read from metadata.yaml. Release from main only."
        required: false
        type: string
  push:
    branches: [main]
    paths:
      - "mods/__MOD_ID__/**"
      - ".github/workflows/release-__MOD_ID__.yml"

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Resolve version
        id: ver
        run: |
          if [ -n "${{ inputs.version }}" ]; then
            VERSION="${{ inputs.version }}"
          else
            VERSION=$(grep '^Version:' mods/__MOD_ID__/metadata.yaml | awk '{print $2}')
          fi
          echo "version=$VERSION" >> "$GITHUB_OUTPUT"
          echo "tag=__MOD_ID__-v${VERSION}" >> "$GITHUB_OUTPUT"
          echo "zip=__MOD_ID__-${VERSION}.zip" >> "$GITHUB_OUTPUT"

      - name: Package
        run: |
          cd mods
          zip -r "../${{ steps.ver.outputs.zip }}" __MOD_ID__/ \
            -x "__MOD_ID__/.*" -x "__MOD_ID__/__pycache__/*"
          cd ..

      - name: Publish GitHub Release
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          TAG="${{ steps.ver.outputs.tag }}"
          ZIP="${{ steps.ver.outputs.zip }}"
          if gh release view "$TAG" >/dev/null 2>&1; then
            gh release delete "$TAG" --yes
            git push origin ":refs/tags/$TAG" || true
          fi
          gh release create "$TAG" "$ZIP" \
            --target main \
            --title "__MOD_ID__ v${{ steps.ver.outputs.version }}" \
            --notes "Release of __MOD_ID__. Cut from main (dev on beta → merge → release)."
